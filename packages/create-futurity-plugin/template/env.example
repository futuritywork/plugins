# The address Futurity reaches this plugin on. Must be public HTTPS before you
# register; a quick tunnel works while you develop:
#   cloudflared tunnel --url http://localhost:3000
PUBLIC_URL=http://localhost:3000

# The Futurity API that signs the identity token on every call. The SDK reads
# its keys from $FUTURITY_URL/oauth/jwks and checks the token's issuer.
# Production: https://api-v4.futurity.work
# Staging: https://api-v4-staging.futurity.work
# Local Futurity: http://localhost:4000
FUTURITY_URL=https://api-v4.futurity.work

PORT=3000
